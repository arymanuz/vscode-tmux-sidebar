{
  "name": "vscode-tmux-sidebar",
  "displayName": "Tmux Sidebar",
  "description": "Manage tmux sessions, windows and panes from the VS Code sidebar — including WSL, SSH remotes and Windows via psmux.",
  "version": "1.0.1",
  "publisher": "arymanuz",
  "icon": "resources/icon-gallery.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/arymanuz/vscode-tmux-sidebar.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "categories": [
    "Other"
  ],
  "keywords": [
    "tmux",
    "psmux",
    "terminal",
    "multiplexer",
    "session",
    "panes",
    "wsl",
    "ssh",
    "remote"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tmux-sidebar",
          "title": "Tmux Sidebar",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "tmux-sidebar": [
        {
          "id": "vscode-tmux-sidebar",
          "name": "Sessions"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "vscode-tmux-sidebar",
        "contents": "No active tmux sessions yet.\n[New Session](command:vscode-tmux-sidebar.new)\ntmux must be installed and running on your system."
      }
    ],
    "commands": [
      {
        "command": "vscode-tmux-sidebar.attach",
        "title": "Attach to Session",
        "category": "Tmux",
        "icon": "$(debug-start)"
      },
      {
        "command": "vscode-tmux-sidebar.refresh",
        "title": "Refresh Sessions",
        "category": "Tmux",
        "icon": "$(refresh)"
      },
      {
        "command": "vscode-tmux-sidebar.settings",
        "title": "Tmux Sidebar Settings",
        "category": "Tmux",
        "icon": "$(gear)"
      },
      {
        "command": "vscode-tmux-sidebar.rename",
        "title": "Rename Session",
        "category": "Tmux"
      },
      {
        "command": "vscode-tmux-sidebar.renameWindow",
        "title": "Rename Window",
        "category": "Tmux"
      },
      {
        "command": "vscode-tmux-sidebar.new",
        "title": "New Tmux Session",
        "category": "Tmux",
        "icon": "$(add)"
      },
      {
        "command": "vscode-tmux-sidebar.delete",
        "title": "Delete Session",
        "category": "Tmux"
      },
      {
        "command": "vscode-tmux-sidebar.kill-window",
        "title": "Kill Window",
        "category": "Tmux"
      },
      {
        "command": "vscode-tmux-sidebar.newWindow",
        "title": "New Window",
        "category": "Tmux"
      },
      {
        "command": "vscode-tmux-sidebar.splitPane",
        "title": "Split Pane…",
        "category": "Tmux",
        "icon": "$(split-horizontal)"
      },
      {
        "command": "vscode-tmux-sidebar.inline.newWindow",
        "title": "New Window",
        "category": "Tmux",
        "icon": "$(add)"
      },
      {
        "command": "vscode-tmux-sidebar.kill-pane",
        "title": "Kill Pane",
        "category": "Tmux"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "vscode-tmux-sidebar.new",
          "when": "view == vscode-tmux-sidebar",
          "group": "navigation"
        },
        {
          "command": "vscode-tmux-sidebar.refresh",
          "when": "view == vscode-tmux-sidebar",
          "group": "navigation"
        },
        {
          "command": "vscode-tmux-sidebar.settings",
          "when": "view == vscode-tmux-sidebar",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "vscode-tmux-sidebar.attach",
          "when": "view == vscode-tmux-sidebar && (viewItem == tmuxSession || viewItem == tmuxWindow || viewItem == tmuxPane)",
          "group": "inline"
        },
        {
          "command": "vscode-tmux-sidebar.inline.newWindow",
          "when": "view == vscode-tmux-sidebar && viewItem == tmuxSession",
          "group": "inline"
        },
        {
          "command": "vscode-tmux-sidebar.splitPane",
          "when": "view == vscode-tmux-sidebar && viewItem == tmuxPane",
          "group": "inline"
        },
        {
          "command": "vscode-tmux-sidebar.rename",
          "when": "view == vscode-tmux-sidebar && viewItem == tmuxSession",
          "group": "1_modification"
        },
        {
          "command": "vscode-tmux-sidebar.renameWindow",
          "when": "view == vscode-tmux-sidebar && viewItem == tmuxWindow",
          "group": "1_modification"
        },
        {
          "command": "vscode-tmux-sidebar.newWindow",
          "when": "view == vscode-tmux-sidebar && viewItem == tmuxSession",
          "group": "1_modification"
        },
        {
          "command": "vscode-tmux-sidebar.splitPane",
          "when": "view == vscode-tmux-sidebar && viewItem == tmuxPane",
          "group": "1_modification"
        },
        {
          "command": "vscode-tmux-sidebar.delete",
          "when": "view == vscode-tmux-sidebar && viewItem == tmuxSession",
          "group": "2_destructive"
        },
        {
          "command": "vscode-tmux-sidebar.kill-window",
          "when": "view == vscode-tmux-sidebar && viewItem == tmuxWindow",
          "group": "2_destructive"
        },
        {
          "command": "vscode-tmux-sidebar.kill-pane",
          "when": "view == vscode-tmux-sidebar && viewItem == tmuxPane",
          "group": "2_destructive"
        }
      ]
    },
    "configuration": {
      "title": "Tmux Sidebar",
      "properties": {
        "tmuxSidebar.autoRefresh.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Refresh the session tree automatically."
        },
        "tmuxSidebar.autoRefresh.intervalSeconds": {
          "type": "number",
          "default": 3,
          "minimum": 1,
          "maximum": 3600,
          "description": "How often the session tree refreshes, in seconds."
        },
        "tmuxSidebar.newTerminalLocation": {
          "type": "string",
          "enum": [
            "vscode",
            "editor",
            "panel"
          ],
          "default": "vscode",
          "enumDescriptions": [
            "Follow VS Code's terminal.integrated.defaultLocation, read each time a session is created",
            "Always the editor area",
            "Always the bottom panel"
          ],
          "description": "Which create button is offered first (and used by Enter) in the New Session form."
        },
        "tmuxSidebar.programs": {
          "type": "array",
          "default": [
            {
              "commands": [
                "{default-shell}",
                "powershell",
                "cmd",
                "bash",
                "zsh",
                "fish",
                "sh",
                "nu",
                "ksh",
                "dash"
              ]
            },
            {
              "commands": [
                "python3",
                "python",
                "ipython",
                "node",
                "irb",
                "ghci",
                "deno",
                "bun"
              ]
            },
            {
              "commands": [
                "claude",
                "claude --resume",
                "claude --resume --fork-session",
                "claude --model opus",
                "claude --model sonnet",
                "claude --model haiku",
                "claude --model fable"
              ],
              "custom": {
                "prefix": "claude --model",
                "hint": "Claude model — an alias like sonnet, or a full id"
              }
            },
            {
              "commands": [
                "codex",
                "codex resume",
                "codex resume --last",
                "codex fork --last",
                "codex fork",
                "codex -m gpt-5.6-sol",
                "codex -m gpt-5.6-terra",
                "codex -m gpt-5.6-luna"
              ],
              "custom": {
                "prefix": "codex -m",
                "hint": "Codex model, e.g. gpt-5.6-terra"
              }
            },
            {
              "commands": [
                "gemini",
                "gemini --resume latest",
                "gemini -m auto",
                "gemini -m pro",
                "gemini -m flash",
                "gemini -m flash-lite"
              ],
              "custom": {
                "prefix": "gemini -m",
                "hint": "Gemini model name"
              }
            },
            {
              "commands": [
                "agy",
                "agy --continue"
              ],
              "custom": {
                "prefix": "agy --model",
                "hint": "Antigravity model — a name from `agy models`"
              }
            },
            {
              "commands": [
                "kimi",
                "kimi --continue",
                "kimi --session",
                "kimi --plan",
                "kimi -m kimi-for-coding",
                "kimi -m kimi-k2-thinking"
              ],
              "custom": {
                "prefix": "kimi -m",
                "hint": "Kimi model alias, e.g. kimi-k2.6"
              }
            },
            {
              "commands": [
                "openclaw chat",
                "openclaw tui"
              ]
            },
            {
              "commands": [
                "aider",
                "aider --restore-chat-history",
                "aider --architect",
                "aider --watch-files"
              ],
              "custom": {
                "prefix": "aider --model",
                "hint": "Aider model, e.g. anthropic/claude-sonnet-5"
              }
            },
            {
              "commands": [
                "opencode",
                "opencode --continue",
                "opencode --continue --fork"
              ],
              "custom": {
                "prefix": "opencode -m",
                "hint": "provider/model, e.g. anthropic/claude-sonnet-4-5"
              }
            },
            {
              "commands": [
                "goose",
                "goose session --resume",
                "goose session --resume --fork"
              ]
            },
            {
              "commands": [
                "crush",
                "crush --continue"
              ]
            },
            {
              "commands": [
                "lazygit",
                "tig",
                "gitui"
              ]
            }
          ],
          "markdownDescription": "Programs offered by the create form, as groups of commands. A command is both the row label and what runs; its leading binary must be installed for the entry to show, and the group's first available command fronts it (a group with none is hidden). `{default-shell}` stands for the shell tmux itself would start — resolved via `tmux show-options -gv default-shell` when the form opens, launched by its full path, and duplicates of it are dropped. `custom` adds a free-text field whose value is appended to `prefix`. Edit comfortably via the Tmux Sidebar settings page.",
          "items": {
            "type": "object",
            "required": [
              "commands"
            ],
            "properties": {
              "commands": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "custom": {
                "type": "object",
                "required": [
                  "prefix"
                ],
                "properties": {
                  "prefix": {
                    "type": "string"
                  },
                  "hint": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^24.0.14",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.8.3"
  }
}
