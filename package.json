{
  "name": "vscode-tmux-sidebar",
  "displayName": "Tmux Sidebar",
  "description": "A simple extension to view and attach to running tmux sessions from the VS Code sidebar.",
  "version": "1.0.0",
  "publisher": "arymanuz",
  "icon": "resources/icon-gallery.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/arymanuz/vscode-tmux-sidebar.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tmux-sidebar",
          "title": "Tmux Sidebar",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "tmux-sidebar": [
        {
          "id": "vscode-tmux-sidebar",
          "name": "Sessions"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "vscode-tmux-sidebar",
        "contents": "No active tmux sessions yet.\n[New Session](command:vscode-tmux-sidebar.new)\ntmux must be installed and running on your system."
      }
    ],
    "commands": [
      {
        "command": "vscode-tmux-sidebar.attach",
        "title": "Attach to Session",
        "category": "Tmux",
        "icon": "$(debug-start)"
      },
      {
        "command": "vscode-tmux-sidebar.refresh",
        "title": "Refresh Sessions",
        "category": "Tmux",
        "icon": "$(refresh)"
      },
      {
        "command": "vscode-tmux-sidebar.toggleAutoRefresh",
        "title": "Toggle Auto Refresh",
        "category": "Tmux",
        "icon": "$(sync)"
      },
      {
        "command": "vscode-tmux-sidebar.rename",
        "title": "Rename Session",
        "category": "Tmux"
      },
      {
        "command": "vscode-tmux-sidebar.renameWindow",
        "title": "Rename Window",
        "category": "Tmux"
      },
      {
        "command": "vscode-tmux-sidebar.new",
        "title": "New Tmux Session",
        "category": "Tmux",
        "icon": "$(add)"
      },
      {
        "command": "vscode-tmux-sidebar.delete",
        "title": "Delete Session",
        "category": "Tmux"
      },
      {
        "command": "vscode-tmux-sidebar.kill-window",
        "title": "Kill Window",
        "category": "Tmux"
      },
      {
        "command": "vscode-tmux-sidebar.newWindow",
        "title": "New Window",
        "category": "Tmux"
      },
      {
        "command": "vscode-tmux-sidebar.splitPaneRight",
        "title": "Split Pane Right",
        "category": "Tmux",
        "icon": "$(split-horizontal)"
      },
      {
        "command": "vscode-tmux-sidebar.splitPaneDown",
        "title": "Split Pane Down",
        "category": "Tmux",
        "icon": "$(split-vertical)"
      },
      {
        "command": "vscode-tmux-sidebar.inline.newWindow",
        "title": "New Window",
        "category": "Tmux",
        "icon": "$(add)"
      },
      {
        "command": "vscode-tmux-sidebar.kill-pane",
        "title": "Kill Pane",
        "category": "Tmux"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "vscode-tmux-sidebar.new",
          "when": "view == vscode-tmux-sidebar",
          "group": "navigation"
        },
        {
          "command": "vscode-tmux-sidebar.refresh",
          "when": "view == vscode-tmux-sidebar",
          "group": "navigation"
        },
        {
          "command": "vscode-tmux-sidebar.toggleAutoRefresh",
          "when": "view == vscode-tmux-sidebar",
          "group": "1_settings"
        }
      ],
      "view/item/context": [
        {
          "command": "vscode-tmux-sidebar.attach",
          "when": "view == vscode-tmux-sidebar && (viewItem == tmuxSession || viewItem == tmuxWindow || viewItem == tmuxPane)",
          "group": "inline"
        },
        {
          "command": "vscode-tmux-sidebar.inline.newWindow",
          "when": "view == vscode-tmux-sidebar && viewItem == tmuxSession",
          "group": "inline"
        },
        {
          "command": "vscode-tmux-sidebar.splitPaneRight",
          "when": "view == vscode-tmux-sidebar && viewItem == tmuxPane",
          "group": "inline"
        },
        {
          "command": "vscode-tmux-sidebar.splitPaneDown",
          "when": "view == vscode-tmux-sidebar && viewItem == tmuxPane",
          "group": "inline"
        },
        {
          "command": "vscode-tmux-sidebar.rename",
          "when": "view == vscode-tmux-sidebar && viewItem == tmuxSession",
          "group": "1_modification"
        },
        {
          "command": "vscode-tmux-sidebar.renameWindow",
          "when": "view == vscode-tmux-sidebar && viewItem == tmuxWindow",
          "group": "1_modification"
        },
        {
          "command": "vscode-tmux-sidebar.newWindow",
          "when": "view == vscode-tmux-sidebar && viewItem == tmuxSession",
          "group": "1_modification"
        },
        {
          "command": "vscode-tmux-sidebar.splitPaneRight",
          "when": "view == vscode-tmux-sidebar && viewItem == tmuxPane",
          "group": "1_modification"
        },
        {
          "command": "vscode-tmux-sidebar.splitPaneDown",
          "when": "view == vscode-tmux-sidebar && viewItem == tmuxPane",
          "group": "1_modification"
        },
        {
          "command": "vscode-tmux-sidebar.delete",
          "when": "view == vscode-tmux-sidebar && viewItem == tmuxSession",
          "group": "2_destructive"
        },
        {
          "command": "vscode-tmux-sidebar.kill-window",
          "when": "view == vscode-tmux-sidebar && viewItem == tmuxWindow",
          "group": "2_destructive"
        },
        {
          "command": "vscode-tmux-sidebar.kill-pane",
          "when": "view == vscode-tmux-sidebar && viewItem == tmuxPane",
          "group": "2_destructive"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^24.0.14",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.8.3"
  }
}
